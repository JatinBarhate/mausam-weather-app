# Provided by the mobile artifact workflow
EXPO_PUBLIC_DOMAIN=your-replit-development-domain

# Provided by Replit to the shared API server
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Optional future server-side notification configuration; never expose these
# in Expo public environment variables.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Clerk credentials are provisioned and managed by Replit. Do not add them here.
